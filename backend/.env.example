# Auth0 issuer URL for the selected tenant/custom domain.
AUTH0_ISSUER=

# Auth0 API identifier used as the expected JWT audience.
AUTH0_AUDIENCE=

# Auth0 subject of the only account allowed to manage memberships.
SYSTEM_ADMIN_SUBJECT=

# PostgreSQL connection string. Used by cmd/migrate; not read by the API yet.
DATABASE_URL=

# PostgreSQL connection string for the administrative credential. It maps to a
# role that belongs to the membership admin group and is the only credential
# allowed to write memberships.
ADMIN_DATABASE_URL=
