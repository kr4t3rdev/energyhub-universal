# Auth0 issuer URL for the selected tenant/custom domain.
# Plain HTTP is accepted only for loopback development issuers.
AUTH0_ISSUER=

# Auth0 API identifier used as the expected JWT audience.
AUTH0_AUDIENCE=

# Auth0 subject of the only account allowed to manage memberships.
SYSTEM_ADMIN_SUBJECT=

# PostgreSQL connection string used by the API for reads. It maps to a role with
# SELECT only, so row-level security still applies. The API refuses to start
# with a role that is a superuser, that bypasses row level security or that can
# write the membership tables.
DATABASE_URL=

# PostgreSQL connection string for the administrative credential. It maps to a
# role that belongs to the membership admin groups and is the only credential
# allowed to write memberships. It belongs to the administration CLI, never to
# the API process.
ADMIN_DATABASE_URL=

# Privileged PostgreSQL connection used only by cmd/migrate to apply
# migrations and change object ownership. It is mandatory and it has no
# fallback: the runtime credential of the API must never apply migrations.
MIGRATION_DATABASE_URL=

# Address the API listens on.
LISTEN_ADDR=:8080
