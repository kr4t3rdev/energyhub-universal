# Configuración del emisor OIDC de desarrollo.
# Copiar a backend/.env.local (ignorado por git) y ajustar solo en local.
# Ninguno de estos valores es real: son sintéticos y solo funcionan con cmd/devoidc.

DEV_OIDC_ADDR=127.0.0.1:8089
DEV_OIDC_AUDIENCE=https://api.energyhub.local
DEV_OIDC_CLIENT_ID=energyhub-dev
DEV_OIDC_CLIENT_SECRET=dev-secret

# Usuario admin del emisor de desarrollo.
DEV_OIDC_ADMIN_SUBJECT=dev|admin
DEV_OIDC_ADMIN_USERNAME=admin
DEV_OIDC_ADMIN_PASSWORD=admin-dev

# Usuario sin privilegios del emisor de desarrollo.
DEV_OIDC_USER_SUBJECT=dev|user-1
DEV_OIDC_USER_USERNAME=user1
DEV_OIDC_USER_PASSWORD=user1-dev
